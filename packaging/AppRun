#!/bin/sh
# Horus Control AppImage entry point.
# Uses the host's Python, GTK 4 and PyGObject (Arch: python-gobject, gtk4); bundles only the app.
HERE="$(dirname "$(readlink -f "$0")")"
export PYTHONPATH="$HERE/usr/lib/horus-control"
export PYTHONDONTWRITEBYTECODE=1

for py in python3 python3.14 python3.13 python3.12 python3.11; do
    if command -v "$py" >/dev/null 2>&1 &&
       "$py" -c "import gi; gi.require_version('Gtk', '4.0')" >/dev/null 2>&1; then
        exec "$py" -s -m horus_control "$@"
    fi
done

msg="Horus Control needs Python with GTK 4 and PyGObject. On Arch/CachyOS: sudo pacman -S --needed python-gobject gtk4"
echo "$msg" >&2
command -v notify-send >/dev/null 2>&1 && notify-send "Horus Control can't start" "$msg"
exit 1
